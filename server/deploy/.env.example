# Domain pointing at this VPS (an A record), e.g. api.example.com
FLOKI_DOMAIN=api.example.com
# Long random password; generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Optional: Google sign-in (OAuth client of type "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Needed for public sign-ups: verification emails via Resend (https://resend.com).
# FLOKI_MAIL_FROM must use a domain verified in Resend, e.g. Floki <no-reply@example.com>
RESEND_API_KEY=
FLOKI_MAIL_FROM=
