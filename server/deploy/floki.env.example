# /etc/floki/floki.env for the systemd service (chmod 600, owned by root).
DATABASE_URL=postgres://floki:CHANGE_ME@127.0.0.1:5432/floki
# Only reachable through nginx on the same machine.
FLOKI_BIND=127.0.0.1:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verification emails via Resend (https://resend.com); FLOKI_MAIL_FROM must use a domain verified there
RESEND_API_KEY=
FLOKI_MAIL_FROM=
